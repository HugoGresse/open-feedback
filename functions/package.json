{
    "name": "functions",
    "scripts": {
        "lint": "biome check --error-on-warnings",
        "typecheck": "tsc -p tsconfig.test.json",
        "build": "rm -rf lib && tsc",
        "build:watch": "tsc --watch",
        "dev:api": "npm run build && node lib/api/standalone.js",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log",
        "test": "vitest",
        "format": "biome format --write"
    },
    "engines": {
        "node": "24"
    },
    "main": "lib/index.js",
    "dependencies": {
        "@fastify/auth": "^5.1.1",
        "@fastify/cors": "^11.3.0",
        "@fastify/swagger": "^9.8.1",
        "@fastify/swagger-ui": "^5.2.6",
        "@fastify/type-provider-typebox": "^6.1.0",
        "@google-cloud/storage": "^5.11.1",
        "@scalar/fastify-api-reference": "^1.69.2",
        "@sinclair/typebox": "^0.34.52",
        "fastify": "^5.12.5",
        "fastify-plugin": "^5.1.0",
        "firebase": "^8.8.1",
        "firebase-admin": "^13.10.0",
        "firebase-functions": "^7.4.0",
        "firebase-functions-test": "^3.5.0",
        "firebase-tools": "15.31.0",
        "lodash": "^4.18.1",
        "ts-custom-error": "^3.3.1"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.4",
        "@types/har-format": "^1.2.16",
        "firestore-vitest": "^0.20.2",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    },
    "overrides": {
        "vitest": {
            "esbuild": "0.25.12"
        }
    },
    "private": true,
    "lint-staged": {
        "*.{js,ts,json}": [
            "biome check --write --error-on-warnings --no-errors-on-unmatched"
        ]
    }
}
