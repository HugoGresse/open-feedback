{
    // Typechecks the specs and test utilities, which the build excludes.
    // Vitest resolves imports like a bundler, so the specs do too.
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "module": "preserve",
        "moduleResolution": "bundler",
        "skipLibCheck": true
    },
    "include": ["src"],
    "exclude": []
}
