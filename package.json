{
    "name": "open-feedback",
    "version": "0.34.2",
    "private": true,
    "homepage": "https://openfeedback.io/",
    "type": "module",
    "scripts": {
        "start": "vite",
        "start:prod": "vite --mode production",
        "start:local": "firebase emulators:start --import=./cypress/fixtures/firebase-emulators-data --only firestore,auth,functions,storage & npm run start",
        "start:local:back": "firebase emulators:start --import=./cypress/fixtures/firebase-emulators-data --only firestore,auth,functions,storage",
        "build": "vite build",
        "build:dev": "vite build --mode development",
        "test": "firebase emulators:exec --only firestore vitest",
        "deploy": "npm run build && firebase deploy",
        "deploy:dev": "npm run build:dev && firebase deploy",
        "release": "npm version minor && npm run deploy && git push && git push --tags",
        "doc": "storybook dev -p 6006 --docs",
        "doc:build": "storybook build",
        "cy:open": "env-cmd -f .env.test.local cypress open",
        "cy:run": "cypress run",
        "cy:start": "env-cmd -f .env.test.local npm run start:local:back & env-cmd -f .env.test.local npm run start -- --host",
        "storybook": "storybook dev -p 9009 ",
        "build-storybook": "storybook build ",
        "lint:i18n": "eslint src/**/languages/*.json",
        "prepare": "husky install",
        "exportFirebaseEmulatorsData": "firebase emulators:export ./cypress/fixtures/firebase-emulators-data"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^4.1.3",
        "@firebase/testing": "^0.20.11",
        "@storybook/addon-docs": "^10.6.0",
        "@storybook/react-vite": "^10.6.0",
        "@types/react": "^18.2.66",
        "@types/react-dom": "^18.2.22",
        "@typescript-eslint/eslint-plugin": "^7.18.0",
        "@typescript-eslint/parser": "^7.18.0",
        "@vitejs/plugin-react": "^5.2.0",
        "axe-core": "^4.13.0",
        "cypress": "13.17.0",
        "cypress-axe": "^1.7.0",
        "cypress-if": "^1.17.1",
        "cypress-vite": "^1.10.2",
        "eslint": "^8.57.0",
        "eslint-plugin-cypress": "^3.6.0",
        "eslint-plugin-i18n-json": "^4.0.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^4.6.2",
        "eslint-plugin-react-refresh": "^0.5.7",
        "firebase-tools": "^15.30.2",
        "husky": "^5.1.3",
        "jest-fetch-mock": "^3.2.0",
        "lint-staged": "^10.5.4",
        "prettier": "^3.9.8",
        "storybook": "^10.0.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.6",
        "vitest": "^4.1.11"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emotion/styled": "^11.14.1",
        "@mdi/js": "^7.3.67",
        "@mdi/react": "^1.6.1",
        "@mui/icons-material": "^5.18.0",
        "@mui/lab": "5.0.0-alpha.177",
        "@mui/material": "^5.18.0",
        "@mui/styles": "^5.18.0",
        "@mui/x-data-grid": "^7.29.13",
        "@mui/x-date-pickers": "^7.29.4",
        "@nivo/core": "^0.99.0",
        "@nivo/line": "^0.99.0",
        "clipboard-copy": "^4.0.1",
        "env-cmd": "^10.1.0",
        "file-saver": "^2.0.5",
        "firebase": "^10.14.1",
        "firebaseui": "^6.1.0",
        "formik": "^2.4.9",
        "history": "^5.0.0",
        "i18next": "^19.9.2",
        "i18next-browser-languagedetector": "^6.1.1",
        "image-blob-reduce": "^4.1.0",
        "langmap": "0.0.16",
        "lodash": "4.18.1",
        "luxon": "3.7.2",
        "prop-types": "latest",
        "qr-code-styling": "^1.9.2",
        "react": "^18.3.1",
        "react-color": "^2.19.3",
        "react-dom": "^18.3.1",
        "react-dropzone": "^11.3.2",
        "react-google-recaptcha-v3": "^1.11.0",
        "react-helmet-async": "^1.2.2",
        "react-hotkeys-hook": "^3.3.1",
        "react-i18next": "^11.14.2",
        "react-redux": "^9.3.0",
        "react-router-dom": "^6.30.6",
        "react-spring": "^8.0.27",
        "react-transition-group": "^4.4.2",
        "redux": "^5.0.1",
        "redux-thunk": "^3.1.0",
        "reselect": "^5.1.0",
        "styled-components": "^6.5.3",
        "styled-system": "^5.1.5",
        "wait-on": "^7.2.0",
        "yup": "^0.32.9"
    },
    "overrides": {
        "@storybook/csf-plugin": {
            "esbuild": "0.25.11"
        },
        "storybook": {
            "esbuild": "0.25.11"
        },
        "vite": {
            "esbuild": "0.25.11"
        },
        "@mui/styles": {
            "react": "react"
        }
    },
    "eslintIgnore": [
        "*.ts"
    ],
    "browserslist": [
        ">0.2%",
        "not dead",
        "not ie <= 11",
        "not op_mini all"
    ],
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "*.{ts,js,json,css,md}": [
            "prettier --write"
        ]
    }
}
