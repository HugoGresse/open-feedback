{
    "name": "open-feedback",
    "version": "0.37.0",
    "private": true,
    "homepage": "https://openfeedback.io/",
    "type": "module",
    "scripts": {
        "start": "vite",
        "start:prod": "vite --mode production",
        "start:local": "firebase emulators:start --import=./cypress/fixtures/firebase-emulators-data --only firestore,auth,functions,storage & npm run start",
        "start:local:back": "firebase emulators:start --import=./cypress/fixtures/firebase-emulators-data --only firestore,auth,functions,storage",
        "build": "vite build",
        "build:dev": "vite build --mode development",
        "test": "firebase emulators:exec --only firestore vitest",
        "deploy": "npm run build && firebase deploy",
        "deploy:dev": "npm run build:dev && firebase deploy",
        "release": "npm version minor && npm run deploy && git push && git push --tags",
        "doc": "storybook dev -p 6006 --docs",
        "doc:build": "storybook build",
        "cy:open": "env-cmd -f .env.test.local -- cypress open",
        "cy:run": "cypress run",
        "cy:start": "env-cmd -f .env.test.local -- npm run start:local:back & env-cmd -f .env.test.local -- npm run start -- --host",
        "storybook": "storybook dev -p 9009 ",
        "build-storybook": "storybook build ",
        "lint": "eslint src .storybook",
        "lint:i18n": "eslint src/**/languages/*.json",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
        "prepare": "husky",
        "exportFirebaseEmulatorsData": "firebase emulators:export ./cypress/fixtures/firebase-emulators-data"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.5.1",
        "@eslint/compat": "^2.1.1",
        "@eslint/js": "^10.0.1",
        "@firebase/testing": "^0.20.11",
        "@storybook/addon-docs": "^10.6.2",
        "@storybook/react-vite": "^10.6.2",
        "@types/luxon": "^3.7.6",
        "@types/react": "^18.3.31",
        "@types/react-color": "^3.0.13",
        "@types/react-dom": "^18.3.7",
        "@types/styled-system": "^5.1.25",
        "@vitejs/plugin-react": "^6.1.2",
        "axe-core": "^4.14.0",
        "cypress": "13.17.0",
        "cypress-axe": "^1.7.0",
        "cypress-if": "^1.17.1",
        "cypress-vite": "^1.10.2",
        "eslint": "^10.13.0",
        "eslint-plugin-cypress": "^7.0.2",
        "eslint-plugin-i18n-json": "^4.0.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "firebase-tools": "^15.34.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "storybook": "^10.6.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^4.1.12"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emotion/styled": "^11.14.1",
        "@mdi/js": "^7.4.47",
        "@mdi/react": "^1.6.1",
        "@mui/icons-material": "^5.18.0",
        "@mui/lab": "5.0.0-alpha.177",
        "@mui/material": "^5.18.0",
        "@mui/styles": "^5.18.0",
        "@mui/x-data-grid": "^8.29.5",
        "@mui/x-date-pickers": "^7.29.4",
        "@nivo/core": "^0.99.0",
        "@nivo/line": "^0.99.0",
        "@nivo/theming": "^0.99.0",
        "clipboard-copy": "^4.0.1",
        "env-cmd": "^11.0.0",
        "file-saver": "^2.0.5",
        "firebase": "^10.14.1",
        "firebaseui": "^6.1.0",
        "formik": "^2.4.9",
        "history": "^5.3.0",
        "i18next": "^26.5.2",
        "i18next-browser-languagedetector": "^8.2.1",
        "image-blob-reduce": "^5.0.1",
        "langmap": "0.0.16",
        "lodash": "4.18.1",
        "luxon": "3.7.2",
        "qr-code-styling": "^1.9.2",
        "react": "^18.3.1",
        "react-color": "^2.19.3",
        "react-dom": "^18.3.1",
        "react-dropzone": "^20.1.4",
        "react-google-recaptcha-v3": "^1.11.0",
        "react-helmet-async": "^3.0.0",
        "react-hotkeys-hook": "^5.3.3",
        "react-i18next": "^17.1.0",
        "react-redux": "^9.3.0",
        "react-router-dom": "^6.30.6",
        "react-spring": "^10.0.4",
        "react-transition-group": "^4.4.5",
        "redux": "^5.0.1",
        "redux-thunk": "^3.1.0",
        "reselect": "^5.3.0",
        "styled-components": "^6.6.0",
        "styled-system": "^5.1.5",
        "wait-on": "^9.5.1",
        "yup": "^1.7.1"
    },
    "overrides": {
        "eslint-plugin-react": {
            "eslint": "$eslint"
        },
        "@mui/styles": {
            "react": "react"
        }
    },
    "browserslist": [
        ">0.2%",
        "not dead",
        "not ie <= 11",
        "not op_mini all"
    ],
    "lint-staged": {
        "*.{ts,js,json,css,md}": [
            "prettier --write"
        ]
    }
}
