# Build config for PR preview channels, deployed to the open-feedback-hugo
# sandbox project. The deploy-side identity (project ID, Workload Identity
# provider, service account) lives in the `env:` block of
# .github/workflows/firebase-hosting-preview-deploy.yml: keep both in sync.
# All values end up in the public client bundle. The web API key is injected
# at deploy time from the PREVIEW_FIREBASE_API_KEY repository variable, so the
# unprivileged fork build never needs it.
VITE_APPID=1:751966180641:web:2d54376ecc5abd74cfda60
VITE_API_KEY=__PREVIEW_FIREBASE_API_KEY__
VITE_AUTH_DOMAIN=open-feedback-hugo.firebaseapp.com
VITE_DATABASE_URL=https://open-feedback-hugo.firebaseio.com
VITE_PROJECT_ID=open-feedback-hugo
VITE_STORAGE_BUCKET=open-feedback-hugo.appspot.com
VITE_MEASUREMENT_ID=
VITE_ADMIN_EMAIL=
VITE_RECAPTCHAV3_SITE_KEY=
VITE_SMALL_CHAT=
VITE_OPEN_SPONSORS=
VITE_API_DOCS_URL=
VITE_EMULATORS=false
